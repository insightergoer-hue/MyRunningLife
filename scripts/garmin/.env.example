# Copy to scripts/garmin/.env and fill in (never commit .env)

GARMIN_EMAIL=your@email.com
GARMIN_PASSWORD=your_password

# China Garmin Connect (garmin.cn) users: set true
GARMIN_IS_CN=false

# Optional: where OAuth tokens are cached after first login
GARMINTOKENS=~/.garminconnect_zhangchaojie

# Optional: git auto-commit/push after sync (true/false)
GARMIN_GIT_AUTO_PUSH=false
