# OS / editor
.DS_Store
Thumbs.db
*.swp
*~

# Local secrets (if any added later)
.env
.env.*
!.env.example
scripts/garmin/.env
credentials.json
*.pem

# Garmin Connect session tokens (never commit)
.garminconnect*
**/.garminconnect*
garmin_tokens/

# Garmin raw API dumps (local only; daily markdown is enough for git)
plans/garmin/raw/**
!plans/garmin/raw/.gitkeep

# Python
__pycache__/
*.py[cod]
*$py.class
.venv/
